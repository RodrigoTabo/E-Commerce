@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Shared.DTOs.AtributoValores
@using E_Commerce.Shared.DTOs.Atributos

@inject AtributoValorApi atributoValorApi
@inject AtributoApi atributoApi

@if (Ver)
{
    <div class="modal-backdrop show"></div>

    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header @(EsEliminacion ? "bg-danger" : "bg-dark") text-white">
                    <h5 class="modal-title">@GetTitulo()</h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="Cerrar">
                    </button>
                </div>

                <div class="modal-body p-4">

                    @if (EsEliminacion)
                    {
                        <div class="text-center">
                            <i class="bi bi-exclamation-triangle text-danger"
                                   style="font-size: 2rem;">
                            </i>

                            <p class="mt-3">
                                ¿Estás seguro de eliminar el valor
                                <strong>@Valor</strong>?
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Atributo</label>

                            <select class="form-select" @bind="IdAtributo">

                                <option value="0" disabled>
                                    -- Selecciona un atributo --
                                </option>

                                @foreach (var atributo in ListaAtributos)
                                {
                                    <option value="@atributo.Id">
                                        @atributo.Nombre
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Nombre del Valor
                            </label>

                            <input type="text"
                                   class="form-control"
                                   @bind="Valor"
                                   placeholder="Ej: XL, Rojo, Algodón..." />
                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <button class="btn btn-light"
                            @onclick="Cerrar">
                        Cancelar
                    </button>

                    <button class="btn @(EsEliminacion ? "btn-danger" : "btn-dark")"
                            @onclick="Confirmar">
                        @GetTextoBoton()
                    </button>

                </div>

            </div>
        </div>
    </div>
}

@code {

    [Parameter]
    public EventCallback OnAccionCompletada { get; set; }

    public bool Ver { get; set; }

    public bool EsEliminacion { get; set; }

    public int? Id { get; set; }

    public int IdAtributo { get; set; }

    public string Valor { get; set; } = string.Empty;

    private List<AtributosResponseDTO> ListaAtributos { get; set; } = new();

    public async Task Abrir(
        int? id = null,
        string valor = "",
        int? idAtributo = null,
        bool eliminar = false)
    {
        await LoadAtributosAsync();

        Id = id;
        Valor = valor;
        IdAtributo = idAtributo ?? 0;

        EsEliminacion = eliminar;

        Ver = true;

        await InvokeAsync(StateHasChanged);
    }

    public void Cerrar()
    {
        Ver = false;
    }

    private string GetTitulo()
    {
        if (EsEliminacion)
            return "Confirmar Eliminación";

        return Id == null
            ? "Nuevo Valor"
            : "Editar Valor";
    }

    private string GetTextoBoton()
    {
        if (EsEliminacion)
            return "Eliminar";

        return Id == null
            ? "Crear"
            : "Guardar Cambios";
    }

    private async Task LoadAtributosAsync()
    {
        try
        {
            ListaAtributos = await atributoApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando atributos: {ex.Message}");
        }
    }

    private async Task Confirmar()
    {
        if (IdAtributo == 0 && !EsEliminacion)
            return;

        try
        {
            if (EsEliminacion)
            {
                // await atributoValorApi.DeleteAsync(Id!.Value);
            }
            else if (Id == null)
            {
                var request = new CreateAtributoValorRequestDTO
                {
                    Valor = Valor,
                    IdAtributo = IdAtributo
                };

                await atributoValorApi.CreateAsync(request);
            }
            else
            {
                var request = new UpdateAtributoValorRequestDTO
                {
                    Id = Id.Value,
                    Valor = Valor,
                    IdAtributo = IdAtributo
                };

                await atributoValorApi.PutAsync(request);
            }

            await OnAccionCompletada.InvokeAsync();

            Cerrar();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en la operación: {ex.Message}");
        }
    }
}