@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Shared.DTOs.AtributoValores
@using E_Commerce.Shared.DTOs.Productos
@using E_Commerce.Shared.DTOs.Reviews
@using E_Commerce.Shared.DTOs.Carritos
@using System.Security.Claims

@inject CarritoApi carritoApi
@inject ProductoApi productoApi
@inject ReviewApi reviewApi
@inject AuthenticationStateProvider AuthStateProvider

@if (Cargando && Model == null)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border"></div>
    </div>
}
else if (Model is not null)
{
    <MudDialog MaxWidth="MaxWidth.False" FullWidth="true" Style="width:80vw; max-width:80vw;">
        <DialogContent>

            <div class="d-flex justify-content-end">
                <button class="btn" @onclick="Cancel">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="row g-4">

                <div class="col-12 col-md-7">
                    <div class="d-flex align-items-center justify-content-center" style="height:450px;">
                        <img src="@Model.UrlImagen" style="max-width:100%; max-height:100%; object-fit:contain;" />
                    </div>
                </div>

                <div class="col-12 col-md-5 d-flex flex-column gap-3">

                    <div>
                        <h4 class="mb-1">@Model.Nombre</h4>

                        <small class="text-muted">
                            @Model.MarcaNombre · @Model.Modelo · @Model.CategoriaNombre
                        </small>
                    </div>

                    <p class="text-muted mb-0">@Model.Descripcion</p>

                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-secondary">@Model.NombreVendedor</span>
                        <span class="badge bg-info">
                            ⭐ @Model.PromedioEstrellas.ToString("0.0") (@Model.TotalReviews)
                        </span>
                    </div>

                    @if (Model.Variantes != null && Model.Variantes.Any())
                    {
                        <div>
                            <h6 class="fw-bold mb-2">
                                Seleccioná talle (ARG)
                            </h6>

                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var v in Model.Variantes)
                                {
                                    var talle = v.Atributos.FirstOrDefault(a => a.Atributo == "Talle")?.Valor;

                                    <button type="button"
                                            class="btn btn-sm @(selectedVariantId == v.Id ? "btn-dark" : "btn-outline-dark")"
                                            disabled="@(v.Stock == 0)"
                                            @onclick="() => SeleccionarVariante(v.Id, v.Stock)">
                                        @talle
                                    </button>
                                }
                            </div>

                            <small class="text-muted d-block mt-2">
                                Los talles disponibles pueden variar según stock
                            </small>
                        </div>
                    }

                    @if (selectedVariantId != 0)
                    {
                        <div>

                            <label class="form-label fw-bold">
                                Cantidad
                            </label>

                            <div class="d-flex align-items-center gap-3">

                                <div class="input-group" style="width:140px;">

                                    <button class="btn btn-outline-dark"
                                            type="button"
                                            @onclick="() => ModificarCantidad(-1)"
                                            disabled="@(cantidadSeleccionada <= 1)">
                                        <i class="bi bi-dash"></i>
                                    </button>

                                    <span class="form-control text-center">
                                        @cantidadSeleccionada
                                    </span>

                                    <button class="btn btn-outline-dark"
                                            type="button"
                                            @onclick="() => ModificarCantidad(1)"
                                            disabled="@(cantidadSeleccionada >= selectedVariantStock)">
                                        <i class="bi bi-plus"></i>
                                    </button>

                                </div>

                                <span class="text-muted small">
                                    (@selectedVariantStock disponibles)
                                </span>

                            </div>

                            <button @onclick="AddCarrito" class="btn btn-dark w-100 mt-3 py-2 fw-bold">
                                AGREGAR AL CARRITO
                            </button>

                        </div>
                    }

                </div>

            </div>

            <hr />

            <div>

                <h6 class="mb-3">
                    Reseñas (@Model.ReviewDTO.Count)
                </h6>

                @foreach (var review in Model.ReviewDTO)
                {
                    <div class="card mb-2">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <span>@review.UsuarioNombre</span>

                                <div>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= review.rating ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </div>

                            </div>

                            <p class="mb-2">
                                @review.comentario
                            </p>

                            @if (review.UsuarioId == currentUserId)
                            {
                                <button class="btn btn-sm btn-link text-danger p-0"
                                        @onclick="() => EliminarReview(review.Id)">
                                    Eliminar
                                </button>
                            }

                        </div>

                    </div>
                }

            </div>

            <div class="mt-4">

                <h6 class="mb-2">
                    Deja tu opinión
                </h6>

                <div class="mb-2">

                    @for (int i = 1; i <= 5; i++)
                    {
                        int star = i;

                        <i class="bi @(star <= nuevaReview.Rating ? "bi-star-fill" : "bi-star")"
                               style="cursor:pointer;"
                               @onclick="() => SeleccionarRating(star)">
                        </i>
                    }

                </div>

                <textarea class="form-control mb-2"
                          rows="3"
                              @bind="nuevaReview.Comentario">
                </textarea>

                    <div class="d-flex justify-content-between align-items-center gap-2">

                        @if (!string.IsNullOrEmpty(Error))
                        {
                            <small class="text-danger">
                                @Error
                            </small>
                        }

                        <button class="btn btn-primary"
                                @onclick="EnviarComentario"
                                disabled="@(nuevaReview.Rating == 0 || string.IsNullOrWhiteSpace(nuevaReview.Comentario) || Cargando)">

                            @if (Cargando)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }

                            Publicar

                        </button>

                    </div>

                </div>

            </DialogContent>
        </MudDialog>
    }

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public int Id { get; set; }

    private ProductoDetalleDTO Model;
    private AtributoValorDTO atributo;
    private CrearReviewDTO nuevaReview = new();

    private bool Cargando;
    private string? Error;
    private Guid? currentUserId;

    private int selectedVariantId = 0;
    private int selectedVariantStock = 0;
    private int cantidadSeleccionada = 1;

    protected override async Task OnInitializedAsync()
    {
        await GetCurrentUserId();
        await LoadProductoById();
    }

    protected override void OnParametersSet()
    {
        nuevaReview.IdProducto = Id;
    }

    private async Task LoadProductoById()
    {
        Cargando = true;

        try
        {
            Model = await productoApi.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task GetCurrentUserId()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var idString = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(idString, out var parsed))
        {
            currentUserId = parsed;
        }
    }

    private void SeleccionarRating(int estrellas)
    {
        nuevaReview.Rating = estrellas;
    }

    private async Task EnviarComentario()
    {
        if (Cargando)
        {
            return;
        }

        Cargando = true;
        Error = null;

        try
        {
            await reviewApi.CreateAsync(nuevaReview);

            nuevaReview = new CrearReviewDTO
            {
                IdProducto = Id,
                Rating = 0
            };

            await LoadProductoById();
        }
        catch
        {
            Error = "Error al publicar";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task EliminarReview(int id)
    {
        // TODO: implementar
    }

    private async Task AddCarrito()
    {
        Error = null;

        try
        {
            var dto = new AgregarCarritoDTO(selectedVariantId, cantidadSeleccionada);

            await carritoApi.CreateAsync(dto);
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }

    private void ModificarCantidad(int valor)
    {
        int nuevaCantidad = cantidadSeleccionada + valor;

        if (nuevaCantidad >= 1 && nuevaCantidad <= selectedVariantStock)
        {
            cantidadSeleccionada = nuevaCantidad;
        }
    }

    private void SeleccionarVariante(int id, int stock)
    {
        selectedVariantId = id;
        selectedVariantStock = stock;
        cantidadSeleccionada = 1;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}