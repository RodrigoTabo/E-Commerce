@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Shared.DTOs.Productos
@inject IDialogService DialogService
@inject FavoritoApi favoritoApi

@if (Items != null && Items.Any())
{
    <style global>
        /* Estilos Catálogo - Identidad brutalista/minimalista idéntica al Perfil */
        .apex-catalog-brutalist {
            font-family: inherit;
        }

            /* Envoltorio de imagen adaptado al estilo del contenedor de la foto de perfil */
            .apex-catalog-brutalist .product-img-wrapper {
                position: relative;
                background-color: #white;
                border: 1px solid #000000; /* border-dark */
                border-radius: 0px !important; /* rounded-0 */
                aspect-ratio: 1 / 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
            }

            .apex-catalog-brutalist .product-img {
                max-width: 100%;
                max-height: 100%;
                object-fit: cover;
            }

            /* Etiquetas planas como el badge del perfil */
            .apex-catalog-brutalist .badge-flat {
                position: absolute;
                top: 0;
                left: 0;
                margin: 0; /* Pegado al borde superior izquierdo */
                text-transform: uppercase;
                font-size: 0.65rem;
                padding: 4px 8px;
                font-weight: 700;
                letter-spacing: 1px;
                border-bottom: 1px solid #000000;
                border-right: 1px solid #000000;
            }

            /* Botón de acción idéntico a los botones del perfil */
            .apex-catalog-brutalist .btn-action-flat {
                background-color: #212529; /* btn-dark */
                color: #ffffff;
                border: none;
                border-radius: 0px; /* rounded-0 */
                font-weight: bold;
                text-transform: uppercase;
                font-size: 0.7rem;
                letter-spacing: 1px;
                padding: 8px 0;
                width: 100%;
                transition: background-color 0.1s ease;
            }

                .apex-catalog-brutalist .btn-action-flat:hover {
                    background-color: #000000;
                }

            /* Botón de Favoritos Brutalista */
            .apex-catalog-brutalist .btn-fav {
                position: absolute;
                top: 0;
                right: 0;
                background-color: #ffffff;
                color: #000000;
                border-bottom: 1px solid #000000;
                border-left: 1px solid #000000;
                border-top: none;
                border-right: none;
                border-radius: 0px !important;
                padding: 6px 10px;
                font-size: 0.9rem;
                line-height: 1;
                z-index: 10;
                transition: background-color 0.1s ease;
            }

                .apex-catalog-brutalist .btn-fav:hover {
                    background-color: #f8f9fa;
                    color: #dc3545; /* Se pone rojo al pasar el mouse */
                }
    </style>

    <section class="py-4 my-2 apex-catalog-brutalist">
        <div class="container-xxl">

            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary-subtle">
                @if (!string.IsNullOrWhiteSpace(Titulo))
                {
                    <h5 class="m-0 fw-bolder text-uppercase" style="letter-spacing: 1px; font-size: 1rem;">
                        @Titulo
                    </h5>
                }
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-link text-dark fw-bold text-decoration-none p-0 text-uppercase"
                            style="font-size: 0.8rem; letter-spacing: 1px;"
                            @onclick="Anterior">
                        [ Ant ]
                    </button>
                    <button class="btn btn-link text-dark fw-bold text-decoration-none p-0 text-uppercase"
                            style="font-size: 0.8rem; letter-spacing: 1px;"
                            @onclick="Siguiente">
                        [ Sig ]
                    </button>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var item in Items.Take(4))
                {
                    <div class="col-6 col-md-3">
                        <div class="card border border-dark rounded-0 bg-white h-100">

                            <div class="product-img-wrapper">
                                @if (Titulo.ToLower().Contains("descuento"))
                                {
                                    <span class="badge-flat bg-dark text-white text-uppercase">Top</span>
                                }
                                else
                                {
                                    <span class="badge-flat bg-dark text-white text-uppercase">Nuevo</span>
                                }

                                <button type="button" class="btn-fav" @onclick="() => ToggleFavorito(item.Id)" title="Añadir a favoritos">
                                    ♥
                                </button>

                                <img alt="@item.Nombre" class="product-img rounded-0" src="@GetImage(item.UrlImagen)" />
                            </div>

                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="mb-3">
                                    <label class="d-block fw-bold text-uppercase text-muted mb-1" style="font-size: 0.65rem;">
                                        Apex Performance
                                    </label>
                                    <h4 class="fw-semibold text-dark text-uppercase m-0 text-truncate" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                        @item.Nombre
                                    </h4>
                                </div>

                                <div>

                                    <button class="btn-action-flat" @onclick="@(() => OpenDialogAsync(item.Id))">
                                        Ver Detalles
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>

        </div>
    </section>
}


@code {

    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public List<ProductoResponseDTO> Items { get; set; } = new();
    [Parameter] public bool Loading { get; set; }

    private string? Error;
    int posicion = 0;

    private async Task OpenDialogAsync(int Id)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Id"] = Id,
        };

        var dialog = await DialogService.ShowAsync<ProductoDetailModal>("Simple Dialog", parameters, options);
        var result = await dialog.Result;
    }

    private void Siguiente()
    {
        var primero = Items.FirstOrDefault();
        if (primero != null)
        {
            Items.Remove(primero);
            Items.Add(primero);
        }
        StateHasChanged();
    }

    private void Anterior()
    {
        var ultimo = Items.LastOrDefault();
        if (ultimo != null)
        {
            Items.Remove(ultimo);
            Items.Insert(0, ultimo);
        }
        StateHasChanged();
    }

    private string GetImage(string? urlImagen)
    {
        if (string.IsNullOrWhiteSpace(urlImagen))
            return "/images/default-product.png";

        return $"https://localhost:7145{urlImagen}";
    }

    private async Task ToggleFavorito(int itemId)
    {
        await favoritoApi.ToggleFavorito(itemId);
    }

}