@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Shared.DTOs.Carritos
@using E_Commerce.Shared.DTOs.Productos
@inject IDialogService DialogService
@inject CarritoApi carritoApi

<section class="py-5">
    @foreach (var item in Items)
    {
        <div class="container px-4 px-lg-5 mt-5">
            <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
                <div class="col mb-5">
                    <div class="card h-100">
                        <img class="card-img-top" src="@item.UrlImagen" alt="..." />
                        <div class="card-body p-4">
                            <div class="text-center">
                                <h5 class="fw-bolder">@item.Nombre</h5>
                            </div>
                        </div>
                        <span class="text-muted text-decoration-line-through">@item.Precio</span>
                        <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                            <MudButton @onclick="@(() => AddCarrito(item.Id, item.Stock))" StartIcon="@Icons.Material.Filled.AddShoppingCart" Variant="Variant.Filled" Color="Color.Primary">
                                Add Carrito
                            </MudButton>
                            <MudButton @onclick="@(() => OpenDialogAsync(item.Id))" StartIcon="@Icons.Material.Filled.RemoveRedEye" Variant="Variant.Filled" Color="Color.Primary">
                                Detalles
                            </MudButton>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    }
</section>
@code {

    [Parameter]
    public List<ProductoResponseDTO> Items { get; set; } = new();
    [Parameter]
    public bool Loading { get; set; }

    private string? Error;

    private async Task OpenDialogAsync(int Id)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            ["Id"] = Id,
        };
        var dialog = await DialogService.ShowAsync<ProductoDetailModal>("Simple Dialog", parameters, options);
        var result = await dialog.Result;

    }

    private async Task AddCarrito(int Id, int cantidad)
    {

        Error = null;
        try
        {
            var dto = new AgregarCarritoDTO(Id, cantidad);

            await carritoApi.CreateAsync(dto);
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }

    }
}
