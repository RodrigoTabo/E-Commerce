@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Shared.DTOs.Productos
@inject ProductoApi productoApi

@if (Ver)
{
    <div class="modal-backdrop show"></div>

    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header @(EsEliminacion ? "bg-danger" : "bg-dark") text-white">
                    <h5 class="modal-title">@GetTitulo()</h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="Cerrar">
                    </button>
                </div>

                <div class="modal-body p-4">

                    @if (EsEliminacion)
                    {
                        <div class="text-center">
                            <i class="bi bi-exclamation-triangle text-danger"
                                   style="font-size: 2rem;">
                            </i>

                            <p class="mt-3">
                                ¿Estás seguro de eliminar el producto
                                <strong>@Nombre</strong>?
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre</label>

                            <input type="text"
                                   class="form-control"
                                   @bind="Nombre"
                                   placeholder="Ej: Remera Oversize" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Descripción</label>

                            <textarea class="form-control"
                                      rows="4"
                                      @bind="Descripcion"
                                          placeholder="Descripción del producto">
                            </textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">URL Imagen</label>

                                <input type="text"
                                       class="form-control"
                                       @bind="UrlImagen"
                                       placeholder="https://..." />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Modelo ID</label>

                                <input type="number"
                                       class="form-control"
                                       @bind="IdModelo" />
                            </div>
                        }

                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-light"
                                @onclick="Cerrar">
                            Cancelar
                        </button>

                        <button class="btn @(EsEliminacion ? "btn-danger" : "btn-dark")"
                                @onclick="Confirmar">
                            @GetTextoBoton()
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

@code {

    [Parameter]
    public EventCallback OnAccionCompletada { get; set; }

    public bool Ver { get; set; }
    public bool EsEliminacion { get; set; }
    public int? Id { get; set; }
    public string Nombre { get; set; } = string.Empty;
    public string Descripcion { get; set; } = string.Empty;
    public string UrlImagen { get; set; } = string.Empty;
    public int? IdModelo { get; set; }

    public async Task Abrir(
        int? id = null,
        string nombre = "",
        string descripcion = "",
        string urlImagen = "",
        int? idModelo = null,
        bool eliminar = false)
    {
        Id = id;
        Nombre = nombre;
        Descripcion = descripcion;
        UrlImagen = urlImagen;
        IdModelo = idModelo;

        EsEliminacion = eliminar;

        Ver = true;

        await InvokeAsync(StateHasChanged);
    }

    public void Cerrar()
    {
        Ver = false;
    }

    private string GetTitulo()
    {
        if (EsEliminacion)
            return "Confirmar Eliminación";

        return Id == null
            ? "Nuevo Producto"
            : "Editar Producto";
    }

    private string GetTextoBoton()
    {
        if (EsEliminacion)
            return "Eliminar";

        return Id == null
            ? "Crear"
            : "Guardar Cambios";
    }

    private async Task Confirmar()
    {
        try
        {
            if (EsEliminacion)
            {
                // await productoApi.DeleteAsync(Id!.Value);
            }
            else if (Id == null)
            {
                var request = new CreateProductoRequestDTO
                {
                    Nombre = Nombre,
                    Descripcion = Descripcion,
                    UrlImagen = UrlImagen,
                    IdModelo = IdModelo
                };

                await productoApi.CreateAsync(request);
            }
            else
            {
                var request = new UpdateProductoRequestDTO
                {
                    Id = Id.Value,
                    Nombre = Nombre,
                    Descripcion = Descripcion,
                    UrlImagen = UrlImagen,
                    IdModelo = IdModelo
                };

                await productoApi.PutAsync(request);
            }

            await OnAccionCompletada.InvokeAsync();

            Cerrar();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en la operación: {ex.Message}");
        }
    }
}