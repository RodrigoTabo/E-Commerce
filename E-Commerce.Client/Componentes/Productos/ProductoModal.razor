@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Shared.DTOs.Modelos
@using E_Commerce.Shared.DTOs.Productos
@inject ProductoApi productoApi
@inject ModeloApi modeloApi

@if (Ver)
{
    <div class="modal-backdrop show"></div>

    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header @(EsEliminacion ? "bg-danger" : "bg-dark") text-white">
                    <h5 class="modal-title">@GetTitulo()</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cerrar"></button>
                </div>

                <div class="modal-body p-4">
                    @if (EsEliminacion)
                    {
                        <div class="text-center">
                            <i class="bi bi-exclamation-triangle text-danger" style="font-size: 2rem;"></i>
                            <p class="mt-3">¿Estás seguro de eliminar el producto <strong>@Nombre</strong>?</p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre</label>
                            <input type="text" class="form-control" @bind="Nombre" placeholder="Ej: Remera Oversize" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Descripción</label>
                            <textarea class="form-control" rows="4" @bind="Descripcion" placeholder="Descripción del producto"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Imagen del Producto</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="border border-dark rounded-0 p-1" style="width: 80px; height: 80px;">
                                    <img alt="Producto" class="w-100 h-100 object-fit-cover rounded-0" src="@GetImageUrl()" />
                                </div>
                                <div class="flex-grow-1">
                                    <InputFile OnChange="OnImageSelected" class="form-control form-control-sm" accept=".png,.jpg,.jpeg,.webp" />
                                    <small class="text-muted">Máx. 2MB (PNG, JPG, WEBP)</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Modelo, Marca y Tipo</label>
                            <select class="form-select" @bind="IdModelo">
                                <option value="">Seleccione un modelo...</option>
                                @foreach (var item in modelosItems)
                                {
                                    <option value="@item.Id">@item.ModeloMarcaProducto</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="Cerrar">Cancelar</button>
                    <button class="btn @(EsEliminacion ? "btn-danger" : "btn-dark")" @onclick="Confirmar">
                        @GetTextoBoton()
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public EventCallback OnAccionCompletada { get; set; }

    private List<ModeloDetalleDTO> modelosItems { get; set; } = new();
    private string? Error;

    private IBrowserFile? selectedImage;
    private string? previewImage;

    public bool Ver { get; set; }
    public bool EsEliminacion { get; set; }
    public int? Id { get; set; }
    public string Nombre { get; set; } = string.Empty;
    public string Descripcion { get; set; } = string.Empty;
    public string UrlImagen { get; set; } = string.Empty;
    public int? IdModelo { get; set; }

    public async Task Abrir(int? id = null, string nombre = "", string descripcion = "", string urlImagen = "", int? idModelo = null, bool eliminar = false)
    {
        Id = id;
        Nombre = nombre;
        Descripcion = descripcion;
        UrlImagen = urlImagen;
        IdModelo = idModelo;
        EsEliminacion = eliminar;
        selectedImage = null;
        previewImage = null;

        Ver = true;
        await InvokeAsync(StateHasChanged);
    }

    public void Cerrar() => Ver = false;

    private string GetTitulo() => EsEliminacion ? "Confirmar Eliminación" : (Id == null ? "Nuevo Producto" : "Editar Producto");
    private string GetTextoBoton() => EsEliminacion ? "Eliminar" : (Id == null ? "Crear" : "Guardar Cambios");

    private async Task Confirmar()
    {
        try
        {
            if (EsEliminacion)
            {
                // await productoApi.DeleteAsync(Id!.Value);
            }
            else if (Id == null)
            {
                var request = new CreateProductoRequestDTO
                {
                    Nombre = Nombre,
                    Descripcion = Descripcion,
                    IdModelo = IdModelo,
                    ImagenPerfil = selectedImage
                };
                await productoApi.CreateAsync(request);
            }
            else
            {
                var request = new UpdateProductoRequestDTO
                {
                    Id = Id.Value,
                    Nombre = Nombre,
                    Descripcion = Descripcion,
                    IdModelo = IdModelo,
                    ImagenPerfil = selectedImage
                };
                await productoApi.PutAsync(request);
            }

            await OnAccionCompletada.InvokeAsync();
            Cerrar();
        }
        catch (HttpApiException ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;

        using var stream = selectedImage.OpenReadStream(2 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        previewImage = $"data:{selectedImage.ContentType};base64,{base64}";
    }

    private string GetImageUrl()
    {
        if (!string.IsNullOrWhiteSpace(previewImage))
            return previewImage;

        if (!string.IsNullOrWhiteSpace(UrlImagen))
            return $"https://localhost:7145{UrlImagen}";

        return "/images/default-product.png";
    }

    protected override async Task OnInitializedAsync() => await LoadModelosAsync();

    private async Task LoadModelosAsync()
    {
        try
        {
            modelosItems = await modeloApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }
}