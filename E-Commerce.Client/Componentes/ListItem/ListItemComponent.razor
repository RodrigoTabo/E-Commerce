<div class="row justify-content-center">
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="mb-0">@Title</h5>

        @if (OnCreate.HasDelegate)
        {
            <button type="button"
                    class="btn btn-dark btn-sm shadow-sm"
                    @onclick="OnCreate">

                <i class="bi bi-plus-lg"></i> @CreateButtonText
            </button>
        }

    </div>

    <div class="card shadow-sm border-0">

        <div class="table-responsive">

            <table class="table table-hover table-sm align-middle mb-0">

                <thead class="table-dark">
                    <tr>

                        @foreach (var column in Columns)
                        {
                            <th>@column</th>
                        }

                        <th class="text-end pe-3">Acciones</th>

                    </tr>
                </thead>

                <tbody>

                    @if (Rows.Any())
                    {
                        @foreach (var row in Rows)
                        {
                            <tr>

                                @foreach (var value in row.Values)
                                {
                                    <td>@value</td>
                                }

                                <td class="text-end pe-3">

                                    <div class="btn-group">

                                        <button class="btn btn-outline-secondary btn-sm border-0"
                                                @onclick="() => OnEdit.InvokeAsync(row.Id)">

                                            <i class="bi bi-pencil-square"></i>

                                        </button>

                                        <button class="btn btn-outline-danger btn-sm border-0"
                                                @onclick="() => OnDelete.InvokeAsync(row.Id)">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(Columns.Count + 1)"
                                class="text-center py-4 text-muted">

                                No hay registros.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@code {

    [Parameter] public string Title { get; set; } = "";

    [Parameter] public string CreateButtonText { get; set; } = "Crear";

    [Parameter] public List<string> Columns { get; set; } = [];

    [Parameter] public List<TableRow> Rows { get; set; } = [];

    [Parameter] public EventCallback OnCreate { get; set; }

    [Parameter] public EventCallback<int> OnEdit { get; set; }

    [Parameter] public EventCallback<int> OnDelete { get; set; }

    public class TableRow
    {
        public int Id { get; set; }

        public List<string> Values { get; set; } = [];
    }
}