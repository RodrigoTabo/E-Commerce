<div class="row justify-content-center">
    <div class="col-12 col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Gestión de Atributos</h5>
            <button type="button" class="btn btn-dark btn-sm shadow-sm" @onclick="OnCreate">
                <i class="bi bi-plus-lg"></i> Crear Atributo
            </button>
        </div>

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Nombre Atributo</th>
                            @if (Rows.Any(r => !string.IsNullOrEmpty(r.Col2)))
                            {
                                <th>Valor Atributo</th>
                            }
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Rows)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-secondary">@row.Col1</td>
                                @if (Rows.Any(r => !string.IsNullOrEmpty(r.Col2)))
                                {
                                    <td>@row.Col2</td>
                                }
                                <td class="text-end pe-3">
                                    <div class="btn-group">
                                        <button class="btn btn-outline-secondary btn-sm border-0" @onclick="() => OnEdit.InvokeAsync(row.Id)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm border-0" @onclick="() => OnDelete.InvokeAsync(row.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<TableRow> Rows { get; set; } = [];
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    public class TableRow
    {
        public int Id { get; set; }
        public string Col1 { get; set; } = "";
        public string? Col2 { get; set; }
    }
}