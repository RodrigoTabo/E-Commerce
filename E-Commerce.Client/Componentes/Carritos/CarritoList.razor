@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Shared.DTOs.Carritos
@inject CarritoApi carritoApi

<div class="container">

    @if (Cargando)
    {
        <div class="mb-3">
            <div class="progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div>
            </div>
        </div>
    }

    @if (carrito is null)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-info" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var item in carrito.Items)
            {
                <div class="col-12">

                    <div class="card shadow-sm">
                        <div class="card-body d-flex align-items-center justify-content-between flex-wrap">

                            <div class="d-flex align-items-center gap-3">
                                <img src="@item.ProductoUrlImagen"
                                     alt="Producto"
                                     style="width:70px; height:70px; object-fit:cover; border-radius:8px;" />

                                <div>
                                    <h6 class="mb-1">Producto</h6>
                                    <small class="text-muted">Nombre: @item.ProductoNombre</small>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">

                                <div>
                                    <h6 class="mb-1">Modelo</h6>
                                    <small class="text-muted">@item.ModeloNombre </small>
                                </div>

                            </div>

                            <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">

                                <div>
                                    <h6 class="mb-1">Cantidad</h6>
                                    <small class="text-muted">@item.CarritoCantidad </small>
                                </div>

                            </div>

                            <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">

                                <div>
                                    <h6 class="mb-1">Precio unitario</h6>
                                    <small class="text-muted"> $@item.CarritoPrecio </small>
                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>

<button class="btn btn-primary mt-3"
        @onclick="Continuar">
    Continuar
</button>

@code {
    private CarritoDto? carrito;
    private string? Error;
    private bool Cargando;

    [Parameter] public EventCallback<CarritoDto> OnNext { get; set; }


    protected override async Task OnInitializedAsync()
    {
        carrito = await carritoApi.CarritoUser();
    }

    async Task RecargarCarrito()
    {
        carrito = await carritoApi.CarritoUser();
        StateHasChanged();
    }

    private async Task Continuar()
    {
        await OnNext.InvokeAsync(carrito);
    }

}
