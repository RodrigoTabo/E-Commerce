@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Client.Servicio
@using E_Commerce.Shared.DTOs.Carritos
@inject CarritoApi carritoApi
@inject CarritoStateService carritoStateService
@implements IDisposable

<div class="container">

    @if (Cargando)
    {
        <div class="mb-3">
            <div class="progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div>
            </div>
        </div>
    }

    @if (carrito is null)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-info"></div>
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var item in carrito.Items)
            {
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body d-flex justify-content-between flex-wrap">

                            <div class="d-flex align-items-center gap-3">
                                <img src="@item.ProductoUrlImagen"
                                     style="width:70px;height:70px;object-fit:cover;border-radius:8px;" />

                                <div>
                                    <h6 class="mb-1">@item.ProductoNombre</h6>
                                    <small class="text-muted">@item.ModeloNombre</small>
                                </div>
                            </div>

                            <div>
                                <h6>Cantidad</h6>
                                <small>@item.CarritoCantidad</small>
                            </div>

                            <div>
                                <h6>Precio</h6>
                                <small>$@item.CarritoPrecio</small>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>


@code {
    private CarritoDto? carrito;
    private string? Error;
    private bool Cargando;

    [Parameter] public EventCallback<CarritoDto> OnNext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        carritoStateService.OnChange += RecargarCarritoWrapper;
        carrito = await carritoApi.CarritoUser();
    }

    private async void RecargarCarritoWrapper()
    {
        await RecargarCarrito();
    }

    async Task RecargarCarrito()
    {
        carrito = await carritoApi.CarritoUser();
        StateHasChanged();
    }

    private async Task Continuar()
    {
        await OnNext.InvokeAsync(carrito);
    }

    public void Dispose()
    {
        carritoStateService.OnChange -= RecargarCarritoWrapper;
    }
}
