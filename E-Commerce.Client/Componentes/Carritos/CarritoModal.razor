@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Client.Servicio
@using E_Commerce.Shared.DTOs.Carritos
@inject CarritoApi carritoApi
@inject CarritoStateService carritoStateService

@if (IsOpen)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-0 border border-dark">

                <div class="modal-header bg-white border-bottom border-dark rounded-0 px-4 py-3">

                    <h5 class="modal-title fw-bolder text-uppercase"
                        style="letter-spacing: 1px; font-size: 1rem;">
                        🛒 Tu carrito
                    </h5>

                    <button type="button"
                            class="btn-close rounded-0"
                            @onclick="Cerrar">
                    </button>

                </div>

                <div class="modal-body p-0 bg-white">

                    @if (Cargando)
                    {
                        <div class="d-flex justify-content-center align-items-center p-5">
                            <div class="spinner-border text-dark" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Error))
                    {
                        <div class="alert alert-danger rounded-0 border-0 m-0">
                            @Error
                        </div>
                    }
                    else if (carrito == null || !carrito.Items.Any())
                    {
                        <div class="p-5 text-center">

                            <i class="bi bi-cart-x text-muted fs-1"></i>

                            <p class="text-muted mt-3 text-uppercase fw-bold"
                               style="font-size: 0.8rem;">
                                El carrito está vacío
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush rounded-0">

                            @foreach (var item in carrito.Items)
                            {
                                <div class="list-group-item p-4 border-bottom border-secondary-subtle">

                                    <div class="d-flex align-items-start gap-3">

                                        <img src="@GetImage(item.ProductoUrlImagen)"
                                             alt="@item.ProductoNombre"
                                             style="width: 90px; height: 90px; object-fit: cover;"
                                             class="border rounded-0" />

                                        <div class="flex-grow-1">

                                            <p class="mb-1 fw-bold text-uppercase"
                                               style="font-size: 0.85rem;">
                                                @item.ProductoNombre
                                            </p>

                                            <small class="text-muted">
                                                Modelo: @item.ModeloNombre
                                            </small>

                                            <div class="d-flex align-items-center gap-2 mt-3">

                                                <button class="btn btn-outline-dark btn-sm rounded-0"
                                                        @onclick="() => Restar(item)">
                                                    <i class="bi bi-dash"></i>
                                                </button>

                                                <span class="fw-bold">
                                                    @item.CarritoCantidad
                                                </span>

                                                <button class="btn btn-outline-dark btn-sm rounded-0"
                                                        @onclick="() => Sumar(item)">
                                                    <i class="bi bi-plus"></i>
                                                </button>

                                            </div>

                                        </div>

                                        <div class="text-end">

                                            <p class="fw-bold mb-3">
                                                $@item.CarritoPrecio
                                            </p>

                                            <button class="btn btn-outline-danger btn-sm rounded-0"
                                                    @onclick="() => Eliminar(item)">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </div>

                                    </div>
                                </div>
                            }

                            <div class="p-4 d-flex justify-content-between align-items-center bg-light border-top">

                                <div class="fw-bold text-uppercase">
                                    Total
                                </div>

                                <div class="fw-bold fs-5">
                                    $@carrito.Total
                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="modal-footer border-top border-dark rounded-0">

                    <button class="btn btn-outline-dark rounded-0 text-uppercase"
                            @onclick="Cerrar">
                        Cerrar
                    </button>

                    <button class="btn btn-dark rounded-0 text-uppercase">
                        Finalizar compra
                    </button>

                </div>

            </div>
        </div>
    </div>
}

@code {

    private CarritoDto? carrito;
    private string? Error;
    private bool Cargando;
    private bool IsOpen;

    protected override async Task OnInitializedAsync()
    {
        await RecargarCarrito();
    }

    public async Task Open()
    {
        IsOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    public async Task Cerrar()
    {
        IsOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    async Task Sumar(CarritoItemDto item)
    {
        Cargando = true;
        Error = null;

        try
        {
            await carritoApi.SumarCantidad(item.IdProductoVariante);

            await RecargarCarrito();

            carritoStateService.SetMensaje();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    async Task Restar(CarritoItemDto item)
    {
        Cargando = true;
        Error = null;

        try
        {
            await carritoApi.RestarCantidad(item.IdProductoVariante);

            await RecargarCarrito();

            carritoStateService.SetMensaje();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    async Task Eliminar(CarritoItemDto item)
    {
        Cargando = true;
        Error = null;

        try
        {
            // await carritoApi.EliminarItem(item.ProductoId);

            await RecargarCarrito();

            carritoStateService.SetMensaje();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    async Task RecargarCarrito()
    {
        carrito = await carritoApi.CarritoUser();

        StateHasChanged();

        carritoStateService.SetMensaje();
    }

    private string GetImage(string? urlImagen)
    {
        if (string.IsNullOrWhiteSpace(urlImagen))
            return "/images/default-product.png";

        return $"https://localhost:7145{urlImagen}";
    }
}