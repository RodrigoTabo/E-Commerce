@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Client.Componentes.ListItem
@using E_Commerce.Client.Componentes.Modal
@using E_Commerce.Shared.DTOs.AtributoValores
@inject AtributoValorApi atributoValorApi
@inject AtributoApi atributoApi

<div class="container mt-4">

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger border-0 shadow-sm">
            @Error
        </div>
    }

    <ListItemComponent Title="Gestión de Valores"
                       CreateButtonText="Crear Valor"
                       Columns="columns"
                       Rows="GetRows()"
                       OnCreate="AbrirCrear"
                       OnEdit="AbrirEditar"
                       OnDelete="AbrirEliminar" />

    <CrudModal @ref="modal"
               OnConfirm="ConfirmarOperacion" />

</div>
@code {
    private CrudModal modal = default!;
    private List<ListAtributoValorResponseDTO> atributoValores = [];
    private List<CrudModal.SelectOption> opcionesAtributos = []; 
    private string? Error;

    private readonly List<string> columns = ["Valor", "Atributo"];

    protected override async Task OnInitializedAsync()
    {
        await CargarValoresAsync();
        await CargarOpcionesAtributosAsync();
    }

    private async Task CargarValoresAsync()
    {
        try
        {
            Error = null;
            atributoValores = await atributoValorApi.GetAllAsync();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }

    private async Task CargarOpcionesAtributosAsync()
    {
        try
        {
            var atributos = await atributoApi.GetAllAsync();
            opcionesAtributos = atributos.Select(a => new CrudModal.SelectOption
            {
                Value = a.Id.ToString(),
                Text = a.Nombre
            }).ToList();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }

    private List<ListItemComponent.TableRow> GetRows()
    {
        return atributoValores.Select(a => new ListItemComponent.TableRow
        {
            Id = a.Id,
            Values = [a.Valor, a.Atributo]
        }).ToList();
    }

    private void AbrirCrear()
    {
        modal.Fields = new List<CrudModal.ModalField>
        {
            new() { Label = "Valor del atributo", Type = "text", Value = "" },
            new() { Label = "Atributo", Type = "select", Options = opcionesAtributos, Value = opcionesAtributos.FirstOrDefault()?.Value ?? "" }
        };

        modal.Open(
            entityName: "Valor",
            label: "",
            placeholder: ""
        );
    }

    private void AbrirEditar(int id)
    {
        var valor = atributoValores.FirstOrDefault(a => a.Id == id);
        if (valor is null) return;

        modal.Fields = new List<CrudModal.ModalField>
        {
            new() { Label = "Valor del atributo", Type = "text", Value = valor.Valor },
            new() { Label = "Atributo", Type = "select", Options = opcionesAtributos, Value = valor.IdAtributo.ToString() }
        };

        modal.Open(
            entityName: "Valor",
            label: "",
            placeholder: "",
            id: valor.Id,
            itemName: valor.Valor
        );
    }

    private void AbrirEliminar(int id)
    {
        var valor = atributoValores.FirstOrDefault(a => a.Id == id);
        if (valor is null) return;

        modal.Fields = [];

        modal.Open(
            entityName: "Valor",
            label: "",
            placeholder: "",
            id: valor.Id,
            itemName: valor.Valor,
            isDelete: true
        );
    }

    private async Task ConfirmarOperacion(CrudModal.ModalResult result)
    {
        try
        {
            if (result.IsDelete)
            {
                // await atributoValorApi.DeleteAsync(result.Id!.Value);
            }
            else if (result.Id is null)
            {
                var inputValor = modal.Fields[0].Value;
                var selectIdAtributo = int.Parse(modal.Fields[1].Value);

                await atributoValorApi.CreateAsync(new CreateAtributoValorRequestDTO
                {
                    Valor = inputValor,
                    IdAtributo = selectIdAtributo
                });
            }
            else
            {
                var inputValor = modal.Fields[0].Value;
                var selectIdAtributo = int.Parse(modal.Fields[1].Value);

                await atributoValorApi.PutAsync(new UpdateAtributoValorRequestDTO
                {
                    Id = result.Id.Value,
                    Valor = inputValor,
                    IdAtributo = selectIdAtributo
                });
            }

            await CargarValoresAsync();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }
}