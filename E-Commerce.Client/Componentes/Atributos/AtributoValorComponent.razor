@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Client.Componentes.ListItem
@using E_Commerce.Client.Componentes.Modal
@using E_Commerce.Shared.DTOs.AtributoValores

@inject AtributoValorApi atributoValorApi

<div class="container mt-4">

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger border-0 shadow-sm">
            @Error
        </div>
    }

    <ListItemComponent Title="Gestión de Valores"
                       CreateButtonText="Crear Valor"
                       Columns="columns"
                       Rows="GetRows()"
                       OnCreate="AbrirCrear"
                       OnEdit="AbrirEditar"
                       OnDelete="AbrirEliminar" />

    <CrudModal @ref="modal"
               OnConfirm="ConfirmarOperacion" />

</div>

@code {

    private CrudModal modal = default!;

    private List<ListAtributoValorResponseDTO> atributoValores = [];

    private string? Error;

    private readonly List<string> columns =
    [
        "Valor",
        "Atributo"
    ];

    protected override async Task OnInitializedAsync()
    {
        await CargarValoresAsync();
    }

    private async Task CargarValoresAsync()
    {
        try
        {
            Error = null;

            atributoValores = await atributoValorApi.GetAllAsync();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }

    private List<ListItemComponent.TableRow> GetRows()
    {
        return atributoValores.Select(a => new ListItemComponent.TableRow
        {
            Id = a.Id,

            Values =
            [
                a.Valor,
                a.Atributo
            ]
        }).ToList();
    }

    private void AbrirCrear()
    {
        modal.Open(
            entityName: "Valor",
            label: "Valor del atributo",
            placeholder: "Ej: Rojo, XL..."
        );
    }

    private void AbrirEditar(int id)
    {
        var valor = atributoValores.FirstOrDefault(a => a.Id == id);

        if (valor is null)
            return;

        modal.Open(
            entityName: "Valor",
            label: "Valor del atributo",
            placeholder: "Ej: Rojo, XL...",
            id: valor.Id,
            itemName: valor.Valor
        );
    }

    private void AbrirEliminar(int id)
    {
        var valor = atributoValores.FirstOrDefault(a => a.Id == id);

        if (valor is null)
            return;

        modal.Open(
            entityName: "Valor",
            label: "",
            placeholder: "",
            id: valor.Id,
            itemName: valor.Valor,
            isDelete: true
        );
    }

    private async Task ConfirmarOperacion(CrudModal.ModalResult result)
    {
        try
        {
            if (result.IsDelete)
            {
                // await atributoValorApi.DeleteAsync(result.Id!.Value);
            }
            else if (result.Id is null)
            {
                await atributoValorApi.CreateAsync(new CreateAtributoValorRequestDTO
                {
                    Valor = result.Name
                });
            }
            else
            {
                await atributoValorApi.PutAsync(new UpdateAtributoValorRequestDTO
                {
                    Id = result.Id.Value,
                    Valor = result.Name
                });
            }

            await CargarValoresAsync();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }
}