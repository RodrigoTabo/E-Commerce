@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Shared.DTOs.ProductoVariantes
@inject ProductoVarianteApi productoVarianteApi

<div class="modal fade @(mostrar ? "show d-block" : "")"
     tabindex="-1"
     style="background-color: rgba(0,0,0,0.5);">

    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Variantes del Producto</h5>
                <div>
                    <button type="button"
                            class="btn btn-dark btn-sm shadow-sm me-2"
                            @onclick="AbrirModalCrear">
                        <i class="bi bi-plus-lg"></i> Crear
                    </button>
                    <button type="button"
                            class="btn-close"
                            @onclick="Cerrar">
                    </button>
                </div>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="alert alert-danger">@Error</div>
                }

                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>Atributos</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (listProductoVariantes is not null && listProductoVariantes.Any())
                        {
                            @foreach (var item in listProductoVariantes)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        @if (item.Atributos is not null && item.Atributos.Any())
                                        {
                                            @foreach (var attr in item.Atributos)
                                            {
                                                <span class="badge bg-secondary me-1">
                                                    @attr.Nombre: @attr.Valor
                                                </span>
                                            }
                                        }
                                    </td>
                                    <td>$ @item.Precio</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">@item.Stock</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm me-1"
                                                @onclick="() => AbrirModalEditar(item.Id)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => AbrirModalEliminar(item.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No hay variantes disponibles.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<ProductoVarianteModalCrear @ref="modalProductoVarianteCrear" OnAccionCompletada="LoadProductoVariantes" />

@code {
    private List<ListProductoVariante> listProductoVariantes { get; set; } = new();
    private ProductoVarianteModalCrear modalProductoVarianteCrear;
    private bool mostrar;
    private int Id; 
    private string? Error;

    public async Task Abrir(int id)
    {
        Id = id;
        mostrar = true;
        await LoadProductoVariantes();
        StateHasChanged();
    }

    private void Cerrar() => mostrar = false;

    private async Task LoadProductoVariantes()
    {
        Error = null;
        try
        {
            listProductoVariantes = await productoVarianteApi.GetProductoVarianteByIdProducto(Id);
            StateHasChanged();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }

    private void AbrirModalCrear()
    {
        if (modalProductoVarianteCrear is null) return;
        modalProductoVarianteCrear.Abrir(Id);
    }

    private async Task AbrirModalEditar(int idVariante)
    {
        if (modalProductoVarianteCrear is null) return;

        try
        {
            var variante = await productoVarianteApi.GetByIdAsync(idVariante);
            modalProductoVarianteCrear.Abrir(Id, variante, eliminar: false);
        }
        catch (Exception ex)
        {
            Error = $"No se pudo cargar la variante: {ex.Message}";
        }
    }

    private async Task AbrirModalEliminar(int idVariante)
    {
        if (modalProductoVarianteCrear is null) return;

        try
        {
            var variante = await productoVarianteApi.GetByIdAsync(idVariante);
            modalProductoVarianteCrear.Abrir(Id, variante, eliminar: true);
        }
        catch (Exception ex)
        {
            Error = $"Error al intentar eliminar: {ex.Message}";
        }
    }
}