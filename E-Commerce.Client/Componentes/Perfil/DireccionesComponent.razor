@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Client.Componentes.Domicilio
@using E_Commerce.Shared.DTOs.Domicilios
@inject DomicilioApi domicilioApi

<div class="card border border-dark rounded-0 bg-white h-100">
    <div class="card-header bg-white border-bottom border-dark px-4 py-3 d-flex justify-content-between align-items-center rounded-0">
        <h5 class="m-0 fw-bolder text-uppercase" style="letter-spacing: 1px; font-size: 1rem;">Mis Direcciones</h5>
        <button @onclick="() => AbrirModalCrear()" class="btn btn-dark btn-sm rounded-0 fw-bold text-uppercase" style="font-size: 0.7rem;">
            + Agregar Nueva
        </button>
    </div>

    <div class="card-body p-0">
        <div class="list-group list-group-flush rounded-0">

            @foreach (var dir in domicilioDTOs)
            {
                <div class="list-group-item p-4 border-bottom border-secondary-subtle">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-0 text-secondary small fw-bold mt-2">Calle: @dir.Calle Altura: @dir.Altura</p>
                            <p class="mb-0 text-secondary small fw-bold mt-2">Localidad: @dir.Ciudad </p>
                            <p class="mb-0 text-secondary small fw-bold mt-2">CP: @dir.CodigoPostal</p>
                        </div>

                        <div class="btn-group">
                            <button class="btn btn-outline-secondary btn-sm border-0"
                                    @onclick="() => AbrirModalEditar(dir.Id)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm border-0"
                                    @onclick="() => AbrirModalEliminar(dir.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (!domicilioDTOs.Any())
            {
                <div class="p-5 text-center">
                    <i class="bi bi-geo-alt text-muted fs-1"></i>
                    <p class="text-muted mt-2 text-uppercase fw-bold" style="font-size: 0.8rem;">No tenés direcciones registradas.</p>
                </div>
            }
        </div>
    </div>
</div>

<DomicilioModal @ref="modalInstancia" OnAccionCompletada="LoadDomicilioAsync" />

@code {
    [Parameter] 
    public string UserId { get; set; }
    private List<DomicilioDTO> domicilioDTOs = new();
    private DomicilioModal modalInstancia;
    private string? Error;
    private string? previewImage;
    private bool Cargando;

    protected override async Task OnInitializedAsync() => await LoadDomicilioAsync();

    private async Task LoadDomicilioAsync()
    {
        Cargando = true;
        Error = null;
        try
        {
            domicilioDTOs = await domicilioApi.GetAllAsync();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private void AbrirModalCrear() => modalInstancia.Abrir();

    private void AbrirModalEditar(int id)
    {
        var item = domicilioDTOs.FirstOrDefault(p => p.Id == id);
        if (item != null) modalInstancia.Abrir(item.Id, item.Calle, item.Altura, item.idCiudad, item.CodigoPostal,item.Referencia, false);
    }

    private void AbrirModalEliminar(int id)
    {
        var item = domicilioDTOs.FirstOrDefault(p => p.Id == id);
        if (item != null) modalInstancia.Abrir(item.Id, item.Calle, item.Altura, item.idCiudad, item.CodigoPostal, item.Referencia, true);
    }

}
