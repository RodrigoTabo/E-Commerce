@if (Visible)
{
    <div class="modal-backdrop show"></div>

    <div class="modal show d-block" tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <div class="modal-header @(IsDelete ? "bg-danger" : "bg-dark") text-white">

                    <h5 class="modal-title">@GetTitle()</h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="Close">
                    </button>

                </div>

                <div class="modal-body p-4">

                    @if (IsDelete)
                    {
                        <div class="text-center">

                            <i class="bi bi-exclamation-triangle text-danger"
                                   style="font-size: 2rem;">
                            </i>

                            <p class="mt-2">
                                ¿Estás seguro de eliminar
                                <strong>@ItemName</strong>?
                            </p>

                        </div>
                    }
                    else
                    {
                        @if (Fields.Any())
                        {
                            @foreach (var field in Fields)
                            {
                                <div class="mb-3">

                                    <label class="form-label fw-bold">
                                        @field.Label
                                    </label>

                                    @if (field.Type == "text")
                                    {
                                        <input class="form-control"
                                               @bind="field.Value" />
                                    }

                                    @if (field.Type == "select")
                                    {
                                        <select class="form-select"
                                                @bind="field.Value">

                                            @foreach (var option in field.Options)
                                            {
                                                <option value="@option.Value">
                                                    @option.Text
                                                </option>
                                            }

                                        </select>
                                    }

                                </div>
                            }
                        }
                        else
                        {
                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    @Label
                                </label>

                                <input type="text"
                                       class="form-control"
                                       @bind="ItemName"
                                       placeholder="@Placeholder" />

                            </div>
                        }
                    }

                </div>

                <div class="modal-footer">

                    <button class="btn btn-light"
                            @onclick="Close">

                        Cancelar

                    </button>

                    <button class="btn @(IsDelete ? "btn-danger" : "btn-dark")"
                            @onclick="Confirm">

                        @GetButtonText()

                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code {

    [Parameter] public EventCallback<ModalResult> OnConfirm { get; set; }
    [Parameter] public List<ModalField> Fields { get; set; } = [];

    public bool Visible { get; set; }

    public int? Id { get; set; }

    public bool IsDelete { get; set; }

    public string ItemName { get; set; } = "";

    public string EntityName { get; set; } = "Item";

    public string Label { get; set; } = "Nombre";

    public string Placeholder { get; set; } = "";

    public void Open(string entityName, string label, string placeholder, int? id = null, string itemName = "", bool isDelete = false)
    {
        EntityName = entityName;
        Label = label;
        Placeholder = placeholder;
        Id = id;
        ItemName = itemName;
        IsDelete = isDelete;
        Visible = true;
        StateHasChanged();
    }

    public void Close()
    {
        Visible = false;
    }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync(new ModalResult
        {
            Id = Id,
            Name = ItemName,
            IsDelete = IsDelete
        });

        Close();
    }

    private string GetTitle()
    {
        if (IsDelete)
            return $"Eliminar {EntityName}";

        return Id == null
            ? $"Nuevo {EntityName}"
            : $"Editar {EntityName}";
    }

    private string GetButtonText()
    {
        if (IsDelete)
            return "Eliminar";

        return Id == null
            ? "Crear"
            : "Guardar Cambios";
    }

    public class SelectOption
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }

    public class ModalField
    {
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";

        public string Type { get; set; } = "text";

        public List<SelectOption> Options { get; set; } = [];
    }

    public class ModalResult
    {
        public int? Id { get; set; }

        public string Name { get; set; } = "";

        public bool IsDelete { get; set; }
    }
}