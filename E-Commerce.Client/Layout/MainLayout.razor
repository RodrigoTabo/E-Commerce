@inherits LayoutComponentBase
@using E_Commerce.Client.Common
@using E_Commerce.Client.Componentes.Carritos
@using System.Security.Claims

@inject IDialogService DialogService
@inject JwtAuthStateProvider JwtAuthStateProvider
@inject ApiHttpClientProvider ApiHttpClientProvider
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">

                <a class="navbar-brand" href="/">E-Commerce</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContenido">
                    <div class="row w-100 align-items-center">

                        <div class="col-4 d-flex justify-content-center">
                            <form class="d-flex w-100">
                                <input class="form-control me-2" type="search" placeholder="Buscar..." />
                                <button class="btn btn-outline-success" type="submit">Buscar</button>
                            </form>
                        </div>

                        <div class="col-8 d-flex justify-content-end">
                            <ul class="navbar-nav d-flex flex-row gap-3 align-items-center">

                                @if (currentUserId is not null)
                                {
                                    <li class="nav-item">
                                        <MudButton OnClick="OpenDialogAsync"
                                                   StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary">
                                            Carrito
                                        </MudButton>
                                    </li>

                                    <li class="nav-item">
                                        <MudButton OnClick="Logout"
                                                   StartIcon="@Icons.Material.Filled.Logout"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Secondary">
                                            Salir
                                        </MudButton>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" href="/login">Login</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/register">Registro</a>
                                    </li>
                                }

                            </ul>
                        </div>

                    </div>
                </div>
            </div>
        </nav>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private Guid? currentUserId;

    protected override async Task OnInitializedAsync()
        => await LoadUser();

    private async Task LoadUser()
    {
        var authState = await JwtAuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var idString = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        currentUserId = Guid.TryParse(idString, out var parsed) ? parsed : null;
    }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        await DialogService.ShowAsync<CarritoModal>("Carrito", options);
    }

    private async Task Logout()
    {
        await JwtAuthStateProvider.MarkUserAsLoggedOutAsync();
        ApiHttpClientProvider.ClearAuthorization();

        currentUserId = null; 
        StateHasChanged();

        Navigation.NavigateTo("/login", true);
    }
}