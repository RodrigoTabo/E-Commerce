@inherits LayoutComponentBase
@using E_Commerce.Client.Common
@using E_Commerce.Client.Componentes.Carritos
@using System.Security.Claims

@inject IDialogService DialogService
@inject JwtAuthStateProvider JwtAuthStateProvider
@inject ApiHttpClientProvider ApiHttpClientProvider
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <AuthorizeView Roles="OwnerAdmin">
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>


    <main>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container-fluid d-flex align-items-center justify-content-between">

                <a class="navbar-brand fw-bolder fs-3 m-0" href="/" style="letter-spacing: -1.5px; font-family: 'Arial Black', sans-serif;">
                    ECOMMERCE
                </a>

                <button class="navbar-toggler rounded-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContenido">

                    <form class="d-flex mx-lg-auto my-3 my-lg-0" style="width: 100%; max-width: 500px;">
                        <div class="input-group">
                            <input class="form-control bg-light border-end-0 rounded-0" type="search" placeholder="Buscar productos..." style="border-color: #dee2e6;" />
                            <button class="btn btn-outline-secondary bg-light border-start-0 rounded-0" type="submit" style="border-color: #dee2e6;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        @if (currentUserId is not null)
                        {

                            <li class="nav-item">
                                <button class="btn btn-outline-dark rounded-0 text-uppercase d-flex align-items-center gap-2"
                                        @onclick="OpenModal">
                                    <i class="bi bi-cart"></i>
                                    Carrito
                                </button>
                            </li>
                            <CarritoModal @ref="carritoModal" />
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold text-dark d-flex align-items-center"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false"
                                   style="font-size: 0.85rem; text-transform: uppercase;">
                                    <i class="bi bi-person-circle me-2 fs-5"></i> HOLA
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end border border-dark mt-2 rounded-0 shadow-none"
                                    style="min-width: 200px;">
                                    <li>
                                        <a class="dropdown-item py-2" href="/mis-compras">
                                            <i class="bi bi-bag me-2"></i> Mis compras
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="/perfil">
                                            <i class="bi bi-person me-2"></i> Mi perfil
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button class="dropdown-item py-2 text-danger fw-bold" @onclick="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Salir
                                        </button>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-dark p-0" href="/login" style="font-size: 0.85rem;">INICIAR SESIÓN</a>
                            </li>
                            <li class="nav-item"><span class="text-muted">/</span></li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-dark p-0" href="/register" style="font-size: 0.85rem;">REGISTRARME</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
@code {
    private Guid? currentUserId;
    private CarritoModal? carritoModal;
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
        var authState = await authenticationStateTask;
        var user = authState.User;

        isAdmin = user.IsInRole("Admin");

    }

    private async Task LoadUser()
    {
        var authState = await JwtAuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var idString = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        currentUserId = Guid.TryParse(idString, out var parsed) ? parsed : null;
    }

    private async Task OpenModal()
    {
        if (carritoModal is not null)
        {
            await carritoModal.Open();
        }
    }

    private async Task Logout()
    {
        await JwtAuthStateProvider.MarkUserAsLoggedOutAsync();
        ApiHttpClientProvider.ClearAuthorization();

        currentUserId = null;
        StateHasChanged();

        Navigation.NavigateTo("/login", true);
    }
}