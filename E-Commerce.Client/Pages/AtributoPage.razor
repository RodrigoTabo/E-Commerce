@page "/atributo"
@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Client.Componentes.ListItem
@using E_Commerce.Client.Componentes.Modal
@using E_Commerce.Shared.DTOs.Atributos

@inject AtributoApi atributoApi

<div class="container mt-4">

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger">
            @Error
        </div>
    }

    <ListItemComponent Title="Gestión de Atributos"
                       CreateButtonText="Crear Atributo"
                       Columns="columns"
                       Rows="GetRows()"
                       OnCreate="AbrirCrear"
                       OnEdit="AbrirEditar"
                       OnDelete="AbrirEliminar" />

    <CrudModal @ref="modal"
               OnConfirm="ConfirmarOperacion" />

</div>

@code {

    private CrudModal modal = default!;

    private List<AtributosResponseDTO> atributos = [];

    private string? Error;

    private readonly List<string> columns =
    [
        "Nombre"
    ];

    protected override async Task OnInitializedAsync()
    {
        await CargarAtributosAsync();
    }

    private async Task CargarAtributosAsync()
    {
        try
        {
            Error = null;

            atributos = await atributoApi.GetAllAsync();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }

    private List<ListItemComponent.TableRow> GetRows()
    {
        return atributos.Select(a => new ListItemComponent.TableRow
        {
            Id = a.Id,

            Values =
            [
                a.Nombre
            ]
        }).ToList();
    }

    private void AbrirCrear()
    {
        modal.Open(
            entityName: "Atributo",
            label: "Nombre del atributo",
            placeholder: "Ej: Color, Talle..."
        );
    }

    private void AbrirEditar(int id)
    {
        var atributo = atributos.FirstOrDefault(a => a.Id == id);

        if (atributo is null)
            return;

        modal.Open(
            entityName: "Atributo",
            label: "Nombre del atributo",
            placeholder: "Ej: Color, Talle...",
            id: atributo.Id,
            itemName: atributo.Nombre
        );
    }

    private void AbrirEliminar(int id)
    {
        var atributo = atributos.FirstOrDefault(a => a.Id == id);

        if (atributo is null)
            return;

        modal.Open(
            entityName: "Atributo",
            label: "",
            placeholder: "",
            id: atributo.Id,
            itemName: atributo.Nombre,
            isDelete: true
        );
    }

    private async Task ConfirmarOperacion(CrudModal.ModalResult result)
    {
        try
        {
            if (result.IsDelete)
            {
                // await atributoApi.DeleteAsync(result.Id!.Value);
            }
            else if (result.Id is null)
            {
                await atributoApi.CreateAsync(new CreateAtributoRequestDTO
                {
                    Nombre = result.Name
                });
            }
            else
            {
                await atributoApi.PutAsync(new UpdateAtributoRequestDTO
                {
                    Id = result.Id.Value,
                    Nombre = result.Name
                });
            }

            await CargarAtributosAsync();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }
}