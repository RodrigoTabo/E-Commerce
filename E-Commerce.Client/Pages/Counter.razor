@page "/counter"
@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Componentes
@using E_Commerce.Client.Componentes.Carritos
@using E_Commerce.Client.Componentes.MetodoPagos
@using E_Commerce.Client.Componentes.Ordenes
@using E_Commerce.Shared.DTOs.OrdenCreate
@using E_Commerce.Shared.DTOs.Pagos
@using E_Commerce.Shared.DTOs.Orden
@using E_Commerce.Shared.DTOs.Carritos
@inject OrdenApi ordenApi

<div class="container mt-4">

    <div class="steps-wrapper mb-4">
        <StepItem Numero="1" Titulo="Carrito" Activo="step >= 1" Completo="step > 1" />
        <StepItem Numero="2" Titulo="Envío" Activo="step >= 2" Completo="step > 2" />
        <StepItem Numero="3" Titulo="Pago" Activo="step >= 3" Completo="step > 3" />
        <StepItem Numero="4" Titulo="Confirmar" Activo="step >= 4" Completo="false" />
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            @if (step == 1)
            {
                <CarritoList OnNext="IrPaso2" />
            }

            @if (step == 2)
            {
                <OrdenForm Model="orden" OnNext="IrPaso3" />
            }

            @if (step == 3)
            {
                <MetodoPagoTransferencia Pago="pago" Total="Total" OnNext="IrPaso4" />
            }

            @if (step == 4)
            {
                <ConfirmarOrden Orden="orden" Carrito="carrito" Pago="pago" Total="Total" OnConfirm="ConfirmarTodo" />
            }

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm p-3 sticky-top" style="top:20px;">

                <h5>Resumen</h5>

                <hr />

                <div class="d-flex justify-content-between">
                    <span>Total</span>
                    <strong>$@Total</strong>
                </div>

                <div class="mt-3">
                    <small class="text-muted">
                        Paso actual: @step de 4
                    </small>
                </div>

            </div>

        </div>

    </div>

</div>

@code {

    private int step = 1;

    private CarritoDto? carrito;
    private CreateOrdenRequest orden = new();
    private PagoRequestDTO pago = new();

    private decimal Total =>
        carrito?.Items.Sum(x => x.CarritoCantidad * x.CarritoPrecio) ?? 0;

    private void IrPaso2(CarritoDto c)
    {
        carrito = c;
        step = 2;
    }

    private void IrPaso3(CreateOrdenRequest o)
    {
        orden = o;
        step = 3;
    }

    private void IrPaso4()
    {
        pago.MontoTotal = Total;
        step = 4;
    }

    private async Task ConfirmarTodo()
    {
        pago.MontoTotal = Total;   
        pago.IdMetodoPago = 1; 


        var request = new CrearOrdenConPagoRequest
        {
            Orden = orden,
            Pago = pago
        };

        await ordenApi.CreateAsync(request);
        Console.WriteLine("REQUEST:");
        Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(request));
    }
}