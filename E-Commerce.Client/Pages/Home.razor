@page "/"
@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Client.Componentes.Productos
@using E_Commerce.Client.Componentes.Carritos
@using E_Commerce.Shared.DTOs.Productos
@inject IDialogService DialogService
@inject ProductoApi productoApi

<MudButton @onclick="@(() => OpenDialogAsync())" StartIcon="@Icons.Material.Filled.AddShoppingCart" Variant="Variant.Filled" Color="Color.Primary">
    Carrito
</MudButton>

<ProductoCard Items="items"
              Loading="Cargando" />

<ProductoForm />


@code {

    public List<ProductoResponseDTO> items { get; set; } = new();
    private string? Error;
    private bool Cargando;

    protected override async Task OnInitializedAsync()
        => await ProductList();
    
    private async Task ProductList()
    {
        Cargando = true;
        Error = null;
        try
        {
            items = await productoApi.GetAllAsync();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<CarritoModal>("", options);
        var result = await dialog.Result;

    }


}