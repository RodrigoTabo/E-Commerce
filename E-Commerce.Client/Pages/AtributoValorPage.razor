@page "/atributovalor"
@using E_Commerce.Client.ApiRoutes
@using E_Commerce.Client.Common
@using E_Commerce.Client.Componentes.AtributoValor
@using E_Commerce.Client.Componentes.ListItem
@using E_Commerce.Shared.DTOs.AtributoValores
@inject AtributoValorApi atributoValorApi

<div class="container mt-4">
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger border-0 shadow-sm">
            @Error
        </div>
    }
    <ListItemComponent Rows="GetAtributosRows()"
                       OnCreate="AbrirModalCrear"
                       OnEdit="AbrirModalEditar"
                       OnDelete="AbrirModalEliminar" />

    <AtributoModalValor @ref="modalInstancia" OnAccionCompletada="LoadAtributosValorAsync" />
</div>

@code {
    private AtributoModalValor modalInstancia;
    private List<ListAtributoValorResponseDTO> atributoValor = new();
    public string? Error;

    protected override async Task OnInitializedAsync() => await LoadAtributosValorAsync();

    private async Task LoadAtributosValorAsync()
    {
        Error = null;
        try
        {
            atributoValor = await atributoValorApi.GetAllAsync();
            StateHasChanged();
        }
        catch (HttpApiException ex)
        {
            Error = ex.Message;
        }
    }

    private List<ListItemComponent.TableRow> GetAtributosRows()
    {
        return atributoValor.Select(a => new ListItemComponent.TableRow
        {
            Id = a.Id,
            Col1 = a.Valor,
            Col2 = a.Atributo
        }).ToList();
    }

    private void AbrirModalCrear() => modalInstancia.Abrir();

    private void AbrirModalEditar(int id)
    {
        var item = atributoValor.FirstOrDefault(a => a.Id == id);
        if (item != null) modalInstancia.Abrir(item.Id, item.Valor, item.IdAtributo, false);
    }

    private void AbrirModalEliminar(int id)
    {
        var item = atributoValor.FirstOrDefault(a => a.Id == id);
        if (item != null) modalInstancia.Abrir(item.Id, item.Valor, item.IdAtributo, true);
    }
}