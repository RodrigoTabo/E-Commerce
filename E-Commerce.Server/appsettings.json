{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ECommerceDBContext": "Server = .\\SQLEXPRESS; Initial Catalog = ECommerce_DB; Integrated security = true; Trust Server Certificate = true"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Key": "una-clave-secreta-muy-larga-para-hmac-sha256-que-tiene-32-bytes-de-long",
    "Issuer": "https://localhost:7145", //API
    "Audience": "https://localhost:7039", //Blazor / Frontend
    "ExpireMinutes": 30
  }
}
